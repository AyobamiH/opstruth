{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opstruth",
  "main": "./website/dist/server/server.js",
  "compatibility_date": "2026-06-05",
  "assets": {
    "directory": "./website/dist/client",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "analytics_engine_datasets": [
    {
      "binding": "CRAWLER_ANALYTICS",
      "dataset": "opstruth_agent_discovery"
    }
  ],
  "routes": [
    { "pattern": "opstruth.io", "custom_domain": true }
  ]
}
