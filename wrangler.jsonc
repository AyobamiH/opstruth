{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opstruth",
  "main": "./website/dist/server/server.js",
  "compatibility_date": "2026-06-05",
  "assets": {
    "directory": "./website/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents.txt", "/llms.txt", "/robots.txt", "/sitemap.xml"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "DISCOVERY_ANALYTICS",
      "dataset": "opstruth_discovery"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "opstruth.io", "custom_domain": true }
  ]
}
